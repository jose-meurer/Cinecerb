<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="Platforms\Windows\Windows.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Cinecerb.Client</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <ApplicationTitle>Cinecerb</ApplicationTitle>
        <AssemblyName>$(ApplicationTitle)</AssemblyName>
        <ApplicationId>com.cerb.cinecerb</ApplicationId>
        <ApplicationDisplayVersion>1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <Product>$(ApplicationTitle)</Product>
        <Company>Cerb</Company>
        <Authors>Jose Meurer</Authors>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" />
        <MauiSplashScreen Include="Resources\Splash\splash.png"
                          BaseSize="128,171" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <Target Name="LoadBuildColors" BeforeTargets="ResizetizeCollectItems;GetMauiItems">
        <PropertyGroup>
            <_AppColorsPath>Shared\DesignSystem\AppColors.xaml</_AppColorsPath>
            <_AppColorsNamespaces>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/dotnet/2021/maui' /&gt;&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/winfx/2009/xaml' /&gt;</_AppColorsNamespaces>
        </PropertyGroup>
        <XmlPeek XmlInputPath="$(_AppColorsPath)"
                 Namespaces="$(_AppColorsNamespaces)"
                 Query="/m:ResourceDictionary/m:Color[@x:Key='AppIconBackgroundColor']/text()">
            <Output TaskParameter="Result" PropertyName="AppIconBackgroundColor" />
        </XmlPeek>
        <XmlPeek XmlInputPath="$(_AppColorsPath)"
                 Namespaces="$(_AppColorsNamespaces)"
                 Query="/m:ResourceDictionary/m:Color[@x:Key='BackgroundColor']/text()">
            <Output TaskParameter="Result" PropertyName="AppBackgroundColor" />
        </XmlPeek>
        <Error Condition="'$(AppBackgroundColor)' == '' or '$(AppIconBackgroundColor)' == ''"
               Text="Defina BackgroundColor e AppIconBackgroundColor em AppColors.xaml." />
        <ItemGroup>
            <MauiIcon Update="@(MauiIcon)" Color="$(AppIconBackgroundColor)" />
            <MauiSplashScreen Update="@(MauiSplashScreen)" Color="$(AppBackgroundColor)" />
        </ItemGroup>
    </Target>

</Project>
