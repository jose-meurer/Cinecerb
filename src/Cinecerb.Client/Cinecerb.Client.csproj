<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Import Project="Platforms\Windows\Windows.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Cinecerb.Client</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <ApplicationTitle>Cinecerb</ApplicationTitle>
        <ApplicationId>com.companyname.cinecerb.client</ApplicationId>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <Product>$(ApplicationTitle)</Product>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" />
        <MauiSplashScreen Include="Resources\Splash\splash.png"
                          BaseSize="128,171" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <Target Name="LoadBuildColors" BeforeTargets="ResizetizeCollectItems;GetMauiItems">
        <XmlPeek XmlInputPath="Shared\DesignSystem\AppColors.xaml"
                 Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/dotnet/2021/maui' /&gt;&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/winfx/2009/xaml' /&gt;"
                 Query="/m:ResourceDictionary/m:Color[@x:Key='BootstrapBackground']/text()">
            <Output TaskParameter="Result" PropertyName="BootstrapBackgroundColor" />
        </XmlPeek>
        <XmlPeek XmlInputPath="Shared\DesignSystem\AppColors.xaml"
                 Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/dotnet/2021/maui' /&gt;&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/winfx/2009/xaml' /&gt;"
                 Query="/m:ResourceDictionary/m:Color[@x:Key='AssetForeground']/text()">
            <Output TaskParameter="Result" PropertyName="AssetForegroundColor" />
        </XmlPeek>
        <Error Condition="'$(BootstrapBackgroundColor)' == '' or '$(AssetForegroundColor)' == ''"
               Text="Defina BootstrapBackground e AssetForeground em AppColors.xaml." />
        <ItemGroup>
            <MauiIcon Update="@(MauiIcon)" Color="$(BootstrapBackgroundColor)" />
            <MauiSplashScreen Update="@(MauiSplashScreen)" Color="$(BootstrapBackgroundColor)" />
        </ItemGroup>
    </Target>

</Project>
