<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:composition="clr-namespace:Cinecerb.Client.Composition"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="Cinecerb.Client.MainPage"
             BackgroundColor="{StaticResource Background}">
    <BlazorWebView HostPage="wwwroot/index.html" BackgroundColor="{StaticResource Background}">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="head::after" ComponentType="{x:Type blazor:HeadOutlet}" />
            <RootComponent Selector="#app" ComponentType="{x:Type composition:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
