@page "/"
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<main @ref="_splash" class="splash-screen @(_isReady ? "splash-screen--ready" : null)" aria-labelledby="splash-title" aria-busy="@(!_isReady)">
    <div class="splash-screen__identity">
        <img class="splash-screen__logo"
             src="images/cinecerb-logo.png"
             alt="Logo do aplicativo"
             draggable="false" />
        <h1 id="splash-title" class="splash-screen__name">@AppInfo.Current.Name</h1>
        <div class="splash-screen__line" aria-hidden="true">
            <span class="splash-screen__line-segment"></span>
        </div>
    </div>
</main>

@code {
    private ElementReference _splash;
    private bool _isReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        
        await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Features/Startup/SplashScreen.razor.js");
            await module.InvokeVoidAsync("waitUntilReady", _splash);
    
            _isReady = true;
            StateHasChanged();
    }
}
