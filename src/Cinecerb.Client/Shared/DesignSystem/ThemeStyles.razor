@namespace Cinecerb.Client.Shared.DesignSystem

<HeadContent>
    <style>
        :root {
            --color-primary: @(AppTheme.Primary.ToRgbaHex(includeAlpha: true));
            --color-secondary: @(AppTheme.Secondary.ToRgbaHex(includeAlpha: true));
            --color-background: @(AppTheme.Background.ToRgbaHex(includeAlpha: true));
            --color-surface: @(AppTheme.Surface.ToRgbaHex(includeAlpha: true));
            --color-title-bar-background: @(AppTheme.TitleBarBackground.ToRgbaHex(includeAlpha: true));
            --color-text-primary: @(AppTheme.TextPrimary.ToRgbaHex(includeAlpha: true));
            --color-bootstrap-background: @(AppTheme.BootstrapBackground.ToRgbaHex(includeAlpha: true));
            --color-asset-foreground: @(AppTheme.AssetForeground.ToRgbaHex(includeAlpha: true));
        }
    </style>
</HeadContent>
