@namespace Cinecerb.Client.Shared.DesignSystem

<HeadContent>
    <style>
        :root {
            --color-primary: @(AppTheme.PrimaryColor.ToRgbaHex(includeAlpha: true));
            --color-primary-hover: @(AppTheme.PrimaryHoverColor.ToRgbaHex(includeAlpha: true));
            --color-primary-tint: @(AppTheme.PrimaryTintColor.ToRgbaHex(includeAlpha: true));
            --color-secondary: @(AppTheme.SecondaryColor.ToRgbaHex(includeAlpha: true));
            --color-secondary-hover: @(AppTheme.SecondaryHoverColor.ToRgbaHex(includeAlpha: true));
            --color-glow-soft: @(AppTheme.GlowSoftColor.ToRgbaHex(includeAlpha: true));
            --color-glow: @(AppTheme.GlowColor.ToRgbaHex(includeAlpha: true));
            --color-glow-strong: @(AppTheme.GlowStrongColor.ToRgbaHex(includeAlpha: true));
            --color-glow-intense: @(AppTheme.GlowIntenseColor.ToRgbaHex(includeAlpha: true));
            --color-background: @(AppTheme.BackgroundColor.ToRgbaHex(includeAlpha: true));
            --color-surface: @(AppTheme.SurfaceColor.ToRgbaHex(includeAlpha: true));
            --color-surface-raised: @(AppTheme.SurfaceRaisedColor.ToRgbaHex(includeAlpha: true));
            --color-surface-overlay: @(AppTheme.SurfaceOverlayColor.ToRgbaHex(includeAlpha: true));
            --color-surface-input: @(AppTheme.SurfaceInputColor.ToRgbaHex(includeAlpha: true));
            --color-surface-input-hover: @(AppTheme.SurfaceInputHoverColor.ToRgbaHex(includeAlpha: true));
            --color-surface-input-focus: @(AppTheme.SurfaceInputFocusColor.ToRgbaHex(includeAlpha: true));
            --color-border: @(AppTheme.BorderColor.ToRgbaHex(includeAlpha: true));
            --color-border-primary: @(AppTheme.BorderPrimaryColor.ToRgbaHex(includeAlpha: true));
            --color-border-primary-strong: @(AppTheme.BorderPrimaryStrongColor.ToRgbaHex(includeAlpha: true));
            --color-focus-ring: @(AppTheme.FocusRingColor.ToRgbaHex(includeAlpha: true));
            --color-highlight: @(AppTheme.HighlightColor.ToRgbaHex(includeAlpha: true));
            --color-highlight-subtle: @(AppTheme.HighlightSubtleColor.ToRgbaHex(includeAlpha: true));
            --color-shadow: @(AppTheme.ShadowColor.ToRgbaHex(includeAlpha: true));
            --color-shadow-subtle: @(AppTheme.ShadowSubtleColor.ToRgbaHex(includeAlpha: true));
            --color-shadow-strong: @(AppTheme.ShadowStrongColor.ToRgbaHex(includeAlpha: true));
            --color-shadow-inset: @(AppTheme.ShadowInsetColor.ToRgbaHex(includeAlpha: true));
            --color-shadow-ambient: @(AppTheme.AmbientShadowColor.ToRgbaHex(includeAlpha: true));
            --color-text-shadow: @(AppTheme.TextShadowColor.ToRgbaHex(includeAlpha: true));
            --color-text-primary: @(AppTheme.TextPrimaryColor.ToRgbaHex(includeAlpha: true));
            --color-text-secondary: @(AppTheme.TextSecondaryColor.ToRgbaHex(includeAlpha: true));
            --color-text-placeholder: @(AppTheme.TextPlaceholderColor.ToRgbaHex(includeAlpha: true));
            --color-icon: @(AppTheme.IconColor.ToRgbaHex(includeAlpha: true));
            --color-track-subtle: @(AppTheme.TrackSubtleColor.ToRgbaHex(includeAlpha: true));
            --color-track: @(AppTheme.TrackColor.ToRgbaHex(includeAlpha: true));
        }
    </style>
</HeadContent>
